{
  "name": "seat-safari",
  "version": "1.0.0",
  "description": "Central Library live empty-seat and occupancy tracker",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "build": "npm --prefix client run build",
    "build:vercel": "npm run build && node scripts/copy-vercel-assets.js",
    "dev:client": "npm --prefix client run dev",
    "test": "node tests/occupancy.test.js && node tests/theme.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "campus",
    "study-spaces",
    "library",
    "safari",
    "plan-b",
    "mobile-first"
  ],
  "author": "Seat Safari Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
